      {
        "id": "gan-based-image-editing",
        "title": "Image Editing GANs",
        "repr": "HiSD",
        "tagline": "Disentangling real visual attribute distributions with binary labels using GANs.",
        "detail": "My research started with GAN-based image editing. HiSD was my first paper, and it taught me how to think about structured latent spaces \u2014 disentangling hair color, expression, style into independent, controllable dimensions.",
        "image": "/assets/hisd.png",
        "node": "hisd"
      },
      {
        "id": "3d-gans",
        "title": "3D GANs",
        "repr": "StyleGRAF",
        "tagline": "Disentangle 3D and camera distributions from in-the-wild images using neural rendering and GANs.",
        "detail": "Disentangle 3D and camera distributions from in-the-wild images using neural rendering and GANs.",
        "image": "/assets/stylegraf.png",
        "node": "stylegraf"
      },
      {
        "id": "object-generation",
        "title": "3D Object Generation",
        "repr": "Dual3D",
        "tagline": "Rendering-based multi-view diffusion Model tuned from pretrained text-to-image diffusion model.",
        "detail": "Dual3D tackled the efficiency problem of text-to-3D, introducing a dual-mode latent diffusion approach that made consistent multi-view generation practical.",
        "image": "/assets/dual3d.png",
        "node": "dual3d"
      },
      {
        "id": "scene-generation",
        "title": "3D Scene Generation",
        "repr": "Director3D",
        "tagline": "Generating camera trajectories and full 3D scenes from text descriptions.",
        "detail": "Director3D scaled the ambition up: generating camera trajectories and full 3D scenes from text descriptions, combining spatial reasoning with generative modeling.",
        "image": "/assets/director3d.png",
        "node": "director3d"
      },
      {
        "id": "world-generation",
